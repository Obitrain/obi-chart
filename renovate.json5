{
  // obi-chart — extends the shared Obitrain base (github.com/Obitrain/renovate-config);
  // repo-specific policy below (Expo repo: weekly cadence, Expo-bundled natives,
  // align-deps ownership). Not the :lib preset — its RN-core ignore would also
  // swallow the majors align-deps deliberately lets through.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["github>Obitrain/renovate-config"],

  // weekly, not nightly — low-churn repo
  schedule: ["before 6am on monday"],

  // Rules apply top-to-bottom; later matches override earlier ones.
  packageRules: [
    // peerDependencies are the RN/react compatibility contract — bump by hand.
    { matchDepTypes: ["peerDependencies"], enabled: false },

    // Tier 1 — dev tooling: batch + automerge on green CI.
    {
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "dev tooling",
      automerge: true,
    },

    // Build backbone — a bad bump breaks the package build; review by hand.
    { matchPackageNames: ["react-native-builder-bob"], automerge: false },

    // Peer contracts mirrored in devDeps (kept on the Expo SDK's bundled
    // versions, not align-deps) — solo MR, manual.
    {
      matchPackageNames: ["@shopify/react-native-*", "react-native-gesture-handler"],
      automerge: false,
      addLabels: ["native"],
    },

    // Owned by @rnx-kit/align-deps (see rnx-kit.alignDeps in package.json):
    // routine updates move via `align-deps --write`, not Renovate. Majors still
    // fall through to the rule below.
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      matchPackageNames: [
        "react-native",
        "@react-native/*",
        "@react-native-community/cli*",
        "react",
        "react-test-renderer",
        "react-native-reanimated",
        "react-native-worklets",
        "jest",
      ],
      enabled: false,
    },

    // Majors — surfaced in the dashboard, created on manual approval only.
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
      automerge: false,
      addLabels: ["major-bump"],
    },
  ],
}
