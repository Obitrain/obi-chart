{
  "name": "@obitrain/charts",
  "version": "0.9.1",
  "description": "Charting library for React Native",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace obi-chart-example",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "env:load": "./bin/load-env.sh",
    "release": "./bin/release.sh",
    "check-deps": "npx @rnx-kit/align-deps@latest --diff-mode allow-subset package.json"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/Andarius/obi-chart",
  "author": "Julien Brayere <julien.brayere@obitrain.com> (https://github.com/Andarius)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Andarius/obi-chart/issues"
  },
  "homepage": "https://github.com/Andarius/obi-chart#readme",
  "publishConfig": {
    "registry": "https://gitlab.com/api/v4/projects/10478649/packages/npm/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "^0.82.0",
    "@react-native/eslint-config": "0.74.83",
    "@react-native/metro-config": "^0.82.0",
    "@release-it/conventional-changelog": "^5.0.0",
    "@rnx-kit/align-deps": "^3.3.4",
    "@shopify/react-native-skia": "2.2.12",
    "@types/d3-scale": "^4.0.5",
    "@types/d3-shape": "^3.1.3",
    "@types/jest": "^29.2.1",
    "@types/react": "^19.0.0",
    "commitlint": "^17.0.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "del-cli": "^5.0.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "jest": "^29.2.1",
    "prettier": "^2.0.5",
    "react": "19.1.1",
    "react-native": "^0.82.0",
    "react-native-builder-bob": "^0.20.0",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-reanimated": "^4.2.0",
    "react-test-renderer": "19.1.1",
    "release-it": "^15.0.0",
    "typescript": "^5.0.2"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0 <3.0.0",
    "d3-scale": ">=4.0.2 <5.0.0",
    "d3-shape": ">=3.2.0 <4.0.0",
    "react": "^16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-native": "^0.61.5 || ^0.62.3 || ^0.63.2 || ^0.64.2 || ^0.65.0 || ^0.66.0 || ^0.67.0 || ^0.68.0 || ^0.69.0 || ^0.70.0 || ^0.71.0 || ^0.72.0 || ^0.73.0 || ^0.74.0 || ^0.75.0 || ^0.76.0 || ^0.77.0 || ^0.78.0 || ^0.79.0 || ^0.80.0 || ^0.81.0 || ^0.82.0 || ^0.83.0",
    "react-native-gesture-handler": "^1.9.0 || ^1.10.3 || ^2.3.2 || ^2.5.0 || ^2.6.0 || ^2.9.0 || ^2.12.0 || ^2.14.0 || ^2.18.1 || ^2.20.0 || ^2.22.0 || ^2.24.0 || ^2.26.0 || ^2.28.0 || ^2.29.1",
    "react-native-reanimated": "^1.13.3 || ^2.1.0 || ^2.2.1 || ^2.2.3 || ^2.2.4 || ^2.5.0 || ^2.9.0 || ^2.10.0 || ^2.14.1 || ^3.3.0 || ^3.6.0 || ^3.9.0 || ^3.15.0 || ^3.16.1 || ^3.16.7 || ^3.17.0 || ^3.17.5 || ^3.18.0 || ^3.19.0 || ^4.2.0"
  },
  "workspaces": [
    "example"
  ],
  "resolutions": {
    "react": "19.1.1",
    "react-dom": "19.1.0"
  },
  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": ">= 18.0.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "rnx-kit": {
    "kitType": "library",
    "alignDeps": {
      "presets": [
        "microsoft/react-native",
        "./align-deps-preset.js"
      ],
      "requirements": {
        "development": [
          "react-native@0.82"
        ],
        "production": [
          "react-native@*"
        ]
      },
      "capabilities": [
        "animation",
        "babel-preset-react-native",
        "core",
        "core-android",
        "core-ios",
        "gestures",
        "jest",
        "react",
        "react-test-renderer"
      ]
    }
  }
}
