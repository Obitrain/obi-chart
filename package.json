{
  "name": "@obitrain/charts",
  "version": "0.10.2",
  "description": "Charting library for React Native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "sideEffects": false,
  "scripts": {
    "example": "yarn workspace obi-chart-example",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "gifs": "./bin/capture-gifs.sh",
    "check-deps": "rnx-align-deps --diff-mode allow-subset package.json"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Obitrain/obi-chart.git"
  },
  "author": "Julien Brayere <julien.brayere@obitrain.com> (https://github.com/Andarius)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Obitrain/obi-chart/issues"
  },
  "homepage": "https://github.com/Obitrain/obi-chart#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@types/d3-scale": "^4.0.5",
    "@types/d3-shape": "^3.1.3"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native-community/cli": "^20.1.0",
    "@react-native-community/cli-platform-android": "^20.1.0",
    "@react-native-community/cli-platform-ios": "^20.1.0",
    "@react-native/babel-preset": "^0.86.0",
    "@react-native/eslint-config": "^0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "^0.86.0",
    "@rnx-kit/align-deps": "^4.0.6",
    "@shopify/react-native-skia": "2.6.2",
    "@types/jest": "^29.2.1",
    "@types/react": "^19.2.0",
    "commitlint": "^17.0.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "del-cli": "^5.0.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-ft-flow": "^2.0.3",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "jest": "^29.2.1",
    "prettier": "^2.0.5",
    "react": "^16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-native": "^0.86.0",
    "react-native-builder-bob": "^0.40.17",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-worklets": "^0.10.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.0.2"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0 <3.0.0",
    "d3-scale": ">=4.0.2 <5.0.0",
    "d3-shape": ">=3.2.0 <4.0.0",
    "react": "^16.9.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-native": "^0.79.0 || ^0.80.0 || ^0.81.6 || ^0.82.0 || ^0.83.0 || ^0.84.0 || ^0.85.0 || ^0.86.0 || ^0.87.0",
    "react-native-gesture-handler": "^2.26.0 || ^2.28.0 || ^2.29.1 || ^2.30.0 || ^2.31.1 || ~2.32.0 || ^3.1.0",
    "react-native-reanimated": "^4.0.0 || ~4.5.1",
    "react-native-worklets": ">=0.5.0"
  },
  "workspaces": [
    "example"
  ],
  "resolutions": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": ">= 20.19.4"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleNameMapper": {
      "^react-native-worklets$": "react-native-worklets/src/mock"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js",
      "@shopify/react-native-skia/jestSetup.js",
      "react-native-gesture-handler/jestSetup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@shopify/react-native-skia|react-native-reanimated|react-native-worklets|react-native-gesture-handler|d3-.*|internmap)/)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "rnx-kit": {
    "kitType": "library",
    "alignDeps": {
      "presets": [
        "microsoft/react-native",
        "./align-deps-preset.js"
      ],
      "requirements": {
        "development": [
          "react-native@0.86"
        ],
        "production": [
          "react-native@>=0.79"
        ]
      },
      "capabilities": [
        "animation",
        "babel-preset-react-native",
        "core",
        "core-android",
        "core-ios",
        "gestures",
        "jest",
        "react",
        "react-test-renderer"
      ]
    }
  }
}
